# Copy → deploy/.env.machine-a trên Máy A. Chỉ dùng LAN demo tin cậy.
POSTGRES_DB=dfs
POSTGRES_USER=dfs
POSTGRES_PASSWORD=dfs_local_dev
LOG_LEVEL=INFO

# LAN IP của Máy B (không dùng localhost / 127.0.0.1).
# Ví dụ: 192.168.1.11 — lấy bằng `ipconfig` trên B sau khi cùng Wi-Fi/hotspot.
MACHINE_B_HOST=192.168.1.11

METADATA_BIND=0.0.0.0
METADATA_PORT=8000
NODE_1_BIND=127.0.0.1
NODE_1_PORT=50051

# UI chạy trên Máy A tại port 5173. Thêm origin LAN nếu mở Vite qua IP máy A.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5176","http://localhost:5177","http://localhost:5178","http://localhost:5179"]
