# Native backend settings. Use deploy/.env for Docker Compose.
# Native DB connection needs an explicitly published PostgreSQL port (see README).
DATABASE_URL=postgresql+psycopg://dfs:dfs_local_dev@127.0.0.1:5432/dfs
STORAGE_NODES_JSON='[{"node_id":"node-1","host":"127.0.0.1","port":50051,"failure_domain":"dev_host"},{"node_id":"node-2","host":"127.0.0.1","port":50052,"failure_domain":"dev_host"},{"node_id":"node-3","host":"127.0.0.1","port":50053,"failure_domain":"dev_host"}]'
CHUNK_SIZE_BYTES=2097152
GRPC_MAX_MESSAGE_BYTES=8388608
REPLICATION_FACTOR=2
MAX_FILE_SIZE_BYTES=67108864
HEALTH_INTERVAL_SECONDS=3
HEALTH_RPC_TIMEOUT_SECONDS=1
NODE_DOWN_AFTER_SECONDS=10
CHUNK_RPC_TIMEOUT_SECONDS=5
RPC_MAX_ATTEMPTS=2
CLEANUP_INTERVAL_SECONDS=5
REPAIR_MAX_CHUNKS=8
REPAIR_TIME_BUDGET_SECONDS=30
CORS_ORIGINS='["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5176","http://localhost:5177","http://localhost:5178","http://localhost:5179"]'
DOWNLOAD_TEMP_DIR=.runtime/downloads
LOG_LEVEL=INFO
# Native single storage node. Give every additional process a distinct DATA_DIR/port/id.
NODE_ID=node-1
FAILURE_DOMAIN=dev_host
GRPC_BIND_HOST=0.0.0.0
GRPC_PORT=50051
DATA_DIR=.runtime/node-1/chunks

